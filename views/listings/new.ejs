<% layout("layouts/boilerplate") %>

    <div class="row">
        <div class="col-8 offset-2">
            <br><br>
            <h1>Create a New Listing: </h1>
            <form action="/listings" method="post">
                <div class="mb-3">
                    <lable for="title" class="form-label">Title</lable>
                    <input type="text" name="listing[title]" placeholder="Add a catch title..." class="form-control">
                </div>

                <div class="mb-3">
                    <lable for="description" class="form-label">Description</lable>
                    <textarea name="listing[description]" id="" class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <lable for="image" class="form-label">Image Link</lable>
                    <input type="text" name="listing[image][url]" placeholder="Enter Image/URL Link.."
                        class="form-control">
                </div>

                
                <div class="row">
                    <div class="mb-3 col-md-4" >
                        <lable for="price" class="form-label">Price</lable>
                        <input type="number" name="listing[price]" placeholder="Enter Price..." class="form-control">
    
                    </div>
                    <div class="mb-3 col-md-8">
                        <lable for="location" class="form-label">Location</lable>
                        <input type="text" name="listing[location]" placeholder="Enter Location..."
                            class="form-control">

                    </div>
                </div>
                <div class="mb-3">
                    <lable for="country" class="form-label">Country</lable>
                    <input type="text" name="listing[country]" placeholder="Enter Country..." class="form-control">
                </div>


                <br><br>
                <button class="btn btn-dark add-btn">ADD</button>
                <br><br>
            </form>
        </div>
    </div>